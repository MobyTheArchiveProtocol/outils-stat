# Identifiants Blizzard Battle.net (requis pour toutes les requêtes API)
# https://account.battle.net/ -> Portail développeur
BATTLE_NET_CLIENT_ID=
BATTLE_NET_CLIENT_SECRET=

# Flux OAuth authorization code (optionnel — pour les données strictement liées
# au compte joueur, ex. collections détaillées, si Blizzard valide le scope wow.profile)
# L'URL de redirection doit correspondre à celle enregistrée sur Battle.net, ex:
#   https://<votre-domaine>/api/auth/callback
BATTLE_NET_REDIRECT_URI=

# Secret utilisé pour chiffrer le cookie de session OAuth (optionnel en dev,
# obligatoire en production). Chaîne aléatoire suffisamment longue.
SESSION_SECRET=
